RewriteEngine On
RewriteBase /
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

Redirect 301 /all-milk-2 https://certifeed.com/all-milk-2.html
Redirect 301 /all-milk-2/ https://certifeed.com/all-milk-2.html
Redirect 301 /all-milk-2.html/ https://certifeed.com/all-milk-2.html
Redirect 301 /high-value-2 https://certifeed.com/high-value-2.html
Redirect 301 /high-value-2/ https://certifeed.com/high-value-2.html
Redirect 301 /high-value-2.html/ https://certifeed.com/high-value-2.html
Redirect 301 /high-performance-2 https://certifeed.com/high-performance-2.html
Redirect 301 /high-performance-2/ https://certifeed.com/high-performance-2.html
Redirect 301 /high-performance-2.html/ https://certifeed.com/high-performance-2.html
Redirect 301 /milk-replacer https://certifeed.com/milk-replacer.html
Redirect 301 /milk-replacer/ https://certifeed.com/milk-replacer.html
Redirect 301 /milk-replacer.html/ https://certifeed.com/milk-replacer.html

